</header>

<style>
  header {
    background-color: #333;
    color: white;
    padding: 1rem;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-links {
    list-style: none;
    display: flex;
    margin: 0;
    padding: 0;
  }

  .nav-links li {
    margin-right: 20px;
  }

  .nav-links a {
    color: white;
    text-decoration: none;
  }

  .dropdown-menu {
    display: none;
    position: absolute;
    background-color: #444;
    list-style: none;
    padding: 10px;
    margin-top: 5px;
  }

  .dropdown:hover .dropdown-menu {
    display: block;
  }

  .menu-toggle {
    display: none;
    cursor: pointer;
  }

  .bar {
    display: block;
    width: 25px;
    height: 3px;
    background-color: white;
    margin: 5px 0;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
      flex-direction: column;
      width: 100%;
      text-align: center;
    }

    .nav-links.active {
      display: flex;
    }

    .menu-toggle {
      display: block;
    }

    .dropdown-menu {
        position: static;
    }
  }
</style>

<script>
  const menuToggle = document.getElementById('mobile-menu');
  const navLinks = document.querySelector('.nav-links');

  menuToggle?.addEventListener('click', () => {
    navLinks?.classList.toggle('active');
  });
</script>